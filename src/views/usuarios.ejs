<%- include('partials/head', { titulo: 'Usuários', ativo: 'usuarios' }) %>
<div class="cabeca-pagina"><h1>Usuários</h1></div>
<% if (erro) { %><p class="aviso aviso-erro" role="alert"><%= erro %></p><% } %>
<div class="tabela-rolavel">
<table class="tabela">
  <caption class="so-leitor">Usuários cadastrados</caption>
  <thead><tr><th scope="col">Nome</th><th scope="col">Login</th><th scope="col">Perfil</th><th scope="col">Ativo</th><th scope="col">Ações</th></tr></thead>
  <tbody>
  <% usuarios.forEach(function (usr) { %>
  <tr>
    <td data-rotulo="Nome"><%= usr.nome %></td>
    <td data-rotulo="Login"><%= usr.login %></td>
    <td data-rotulo="Perfil"><%= usr.perfil %></td>
    <td data-rotulo="Ativo"><span class="selo <%= usr.ativo ? 'selo-publicada' : 'selo-inativo' %>"><%= usr.ativo ? 'sim' : 'não' %></span></td>
    <td class="acoes-usuario">
      <form method="post" action="<%= u('/usuarios/' + usr.id + '/senha') %>" class="linha-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="so-leitor" for="senha-<%= usr.id %>">Nova senha provisória de <%= usr.nome %></label>
        <input id="senha-<%= usr.id %>" type="password" name="senha" placeholder="Nova senha provisória" minlength="8" autocomplete="new-password" required>
        <button class="btn btn-pequeno">Redefinir senha</button>
      </form>
      <form method="post" action="<%= u('/usuarios/' + usr.id + '/ativo') %>" class="linha-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="ativo" value="<%= usr.ativo ? '0' : '1' %>">
        <button class="btn btn-pequeno <%= usr.ativo ? 'btn-perigo' : 'btn-claro' %>"><%= usr.ativo ? 'Desativar' : 'Reativar' %></button>
      </form>
    </td>
  </tr>
  <% }) %>
  </tbody>
</table>
</div>
<section class="cartao cartao-medio espaco-cima">
  <h2>Novo usuário</h2>
  <form method="post" action="<%= u('/usuarios') %>" class="formulario">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Nome <input name="nome" required></label>
    <label>Login <input name="login" autocomplete="off" required></label>
    <label>Senha provisória <input type="password" name="senha" minlength="8" autocomplete="new-password" required></label>
    <label>Perfil <select name="perfil"><% perfis.forEach(function (p) { %><option value="<%= p %>"><%= p %></option><% }) %></select></label>
    <div class="acoes-form"><button class="btn btn-primario">Criar usuário</button></div>
  </form>
</section>
<%- include('partials/foot') %>
