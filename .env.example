# Desenvolvimento/uso local. Em produção use deploy/boletim.env.example (/etc/boletim/boletim.env).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=boletim
DB_PASSWORD=troque-esta-senha
DB_NAME=boletim
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Endereço de escuta (padrão 127.0.0.1: acessível só da própria máquina). Nunca exponha o Node diretamente.
HOST=127.0.0.1
PORT=3000
SESSION_HOURS=8
# Cookie de sessão "secure" (padrão true). Em http://localhost sem HTTPS use false.
COOKIE_SECURE=true

# Prefixo de publicação atrás do proxy reverso (que mantém o prefixo ao repassar). Ausente/vazio = raiz.
# Formato: /segmento[/segmento] com letras, dígitos, ".", "_", "~" e "-". Valor inválido impede a subida.
# BASE_PATH=/boletim_ti

# Caminho do Chromium/Chrome/Edge usado para exportar PDF/PNG (opcional; autodetecta em locais padrão)
# CHROMIUM_PATH=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe
# Último recurso no Linux (Ubuntu 24.04 + AppArmor, snap, contêiner): inicia o Chromium com --no-sandbox.
# CHROMIUM_NO_SANDBOX=1
