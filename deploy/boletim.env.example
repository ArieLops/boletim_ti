# /etc/boletim/boletim.env  (modo 640, dono root:boletim). Formato KEY=valor, sem aspas, sem "export".

# --- Banco (MySQL/MariaDB) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=boletim
DB_PASSWORD=TROQUE-PELA-SENHA-DO-BANCO
DB_NAME=boletim

# --- Sessão ---
# Gere com: openssl rand -hex 32   (trocar o valor desconecta todos os usuários)
SESSION_SECRET=
SESSION_HOURS=8

# --- Rede ---
# ATENÇÃO: este arquivo é para uso com systemd/sem Docker. NÃO copie HOST nem CHROMIUM_PATH para o env-file do
# Docker: a imagem define HOST=0.0.0.0 e CHROMIUM_PATH=/usr/bin/chromium e esses valores precisam prevalecer.
# O app escuta só em localhost; o nginx (ou Apache) é a porta de entrada. NÃO use 0.0.0.0.
HOST=127.0.0.1
PORT=3000
# Atrás de HTTPS (produção): true. O cookie de sessão só funciona via HTTPS.
COOKIE_SECURE=true
# Publicação em subdiretório (ex.: http://servidor/boletim_ti/): o proxy deve MANTER o prefixo ao repassar.
# Ausente/vazio = raiz. Veja deploy/apache/README.md e deploy/docker/README.md.
# BASE_PATH=/boletim_ti
# Enquanto o acesso for HTTP (sem HTTPS), use COOKIE_SECURE=false; volte para true ao migrar para HTTPS.

# --- Exportação PDF/PNG (Chromium) ---
# Use um Chrome/Chromium que NÃO seja snap (veja INSTALL.md).
CHROMIUM_PATH=/usr/bin/google-chrome-stable
# Último recurso (Ubuntu 24.04 com AppArmor restringindo user namespaces, snap, contêiner): remove o sandbox.
# Só habilite se scripts/smoke-export.js falhar por causa do sandbox.
# CHROMIUM_NO_SANDBOX=1

# --- Opcional ---
# Custo do bcrypt para senhas (padrão 12).
# BCRYPT_COST=12
